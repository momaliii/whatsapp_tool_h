# Copy this to ".env" on your server and fill in real values.
# docker compose reads it automatically.

# Strong password to open the dashboard (everyone shares this).
WATITOOL_PASSWORD=change-this-to-a-long-random-password

# The domain you pointed at this server's IP (an A record).
# Caddy will get a free HTTPS certificate for it automatically.
DOMAIN=wati.yourdomain.com
